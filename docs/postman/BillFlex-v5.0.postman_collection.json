{
  "info": {
    "name": "Bill-Flex v5.0 - RabbitMQ et notifications",
    "description": "Collection V5. Exécuter les requêtes dans l'ordre indiqué dans docs/postman/README.md. Les arrêts/redémarrages Docker et des services restent manuels.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "notificationUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "secondInvoiceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A - notification-service direct",
      "item": [
        {
          "name": "Email valide - 204",
          "request": {
            "method": "POST",
            "description": "Endpoint manuel uniquement : envoie un email via notification-service. Résultat attendu : HTTP 204 et email visible dans Mailpit.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinataire\": \"client@example.com\",\n  \"objet\": \"Test Bill-Flex\",\n  \"contenu\": \"Message de test\"\n}"
            },
            "url": "{{notificationUrl}}/notifications/email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Email invalide - 400",
          "request": {
            "method": "POST",
            "description": "Email invalide. Résultat attendu : HTTP 400 avec un ApiError.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinataire\": \"not-an-email\",\n  \"objet\": \"Test\",\n  \"contenu\": \"Message\"\n}"
            },
            "url": "{{notificationUrl}}/notifications/email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error body has status', function () { pm.expect(pm.response.json().status).to.eql(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Objet vide - 400",
          "request": {
            "method": "POST",
            "description": "Objet vide. Résultat attendu : HTTP 400 avec un ApiError.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinataire\": \"client@example.com\",\n  \"objet\": \"\",\n  \"contenu\": \"Message\"\n}"
            },
            "url": "{{notificationUrl}}/notifications/email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SMTP arrêté - 503",
          "request": {
            "method": "POST",
            "description": "Exécuter `docker stop mailpit` avant cette requête, puis `docker start mailpit` après. Résultat attendu : HTTP 503.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinataire\": \"client@example.com\",\n  \"objet\": \"SMTP indisponible\",\n  \"contenu\": \"Message\"\n}"
            },
            "url": "{{notificationUrl}}/notifications/email"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 503', function () { pm.response.to.have.status(503); });",
                  "pm.test('Error body has status', function () { pm.expect(pm.response.json().status).to.eql(503); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B - full flow via Gateway",
      "item": [
        {
          "name": "Lister les invoices et sélectionner des BROUILLON",
          "request": {
            "method": "GET",
            "description": "Sélectionne les deux premières invoices BROUILLON de la réponse et les stocke dans invoiceId et secondInvoiceId. Avec le seed actuel, l'id 3 est BROUILLON.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const invoices = pm.response.json().filter(function (invoice) { return invoice.statut === 'BROUILLON'; });",
                  "pm.test('At least one BROUILLON exists', function () { pm.expect(invoices.length).to.be.greaterThan(0); });",
                  "if (invoices.length > 0) { pm.collectionVariables.set('invoiceId', invoices[0].id); }",
                  "if (invoices.length > 1) { pm.collectionVariables.set('secondInvoiceId', invoices[1].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Émettre invoice - 200 et email",
          "request": {
            "method": "PATCH",
            "description": "Résultat attendu : HTTP 200 avec statut EMISE. Vérifier ensuite l'email dans http://localhost:8025.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/{{invoiceId}}/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Statut is EMISE', function () { pm.expect(pm.response.json().statut).to.eql('EMISE'); });",
                  "pm.test('Response invoice id matches variable', function () { pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('invoiceId'))); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C - business errors",
      "item": [
        {
          "name": "Invoice inconnue - 404",
          "request": {
            "method": "PATCH",
            "description": "Un identifiant très élevé est utilisé pour tester une invoice absente. Résultat attendu : HTTP 404, aucun message publié.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/999999/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Émettre la même invoice deux fois - 409",
          "request": {
            "method": "PATCH",
            "description": "Exécuter après la requête d'émission de la section B. Résultat attendu : HTTP 409, aucun second message publié.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/{{invoiceId}}/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "D - deferred processing",
      "item": [
        {
          "name": "Émettre la première invoice consommateur arrêté",
          "request": {
            "method": "PATCH",
            "description": "Arrêter notification-service avant l'appel. Préparer une invoice BROUILLON et exécuter cette requête : HTTP 200. RabbitMQ doit ensuite afficher Ready = 1.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/{{invoiceId}}/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Émettre la deuxième invoice consommateur arrêté",
          "request": {
            "method": "PATCH",
            "description": "Exécuter avec secondInvoiceId défini par la requête de liste : HTTP 200. RabbitMQ doit afficher Ready = 2, puis deux emails après redémarrage de notification-service.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/{{secondInvoiceId}}/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "E - broker down",
      "item": [
        {
          "name": "Broker arrêté - émission reste 200",
          "request": {
            "method": "PATCH",
            "description": "Arrêter RabbitMQ avec `docker stop rabbitmq` avant l'appel. L'émission doit rester HTTP 200, l'erreur AMQP doit être journalisée par service-facturation, puis exécuter `docker start rabbitmq`. Utiliser une invoice BROUILLON non encore émise.",
            "header": [],
            "url": "{{baseUrl}}/service-facturation/invoices/{{secondInvoiceId}}/emettre"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
